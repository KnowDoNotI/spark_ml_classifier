# Index labels
label_indexer = StringIndexer(inputCol="label", outputCol="indexedLabel")
indexer_model = label_indexer.fit(data_trn_raw)

data_trn = indexer_model.transform(data_trn_raw)
data_val = indexer_model.transform(data_val_raw)


# 2. Function to compute class means and covariance matrix in 1 Spark pass
def get_class_stats(df, feature_cols):
    D = len(feature_cols)
    exprs = [F.mean(c).alias(f"mean_{c}") for c in feature_cols]

    for i in range(D):
        for j in range(i, D):
            exprs.append(
                F.covar_samp(feature_cols[i], feature_cols[j]).alias(
                    f"cov_{i}_{j}"
                )
            )

    stats_row = df.select(*exprs).collect()[0]

    mu = np.array([stats_row[f"mean_{c}"] for c in feature_cols])

    cov_matrix = np.zeros((D, D))
    for i in range(D):
        for j in range(i, D):
            val = stats_row[f"cov_{i}_{j}"]
            cov_matrix[i, j] = val
            cov_matrix[j, i] = val

    return mu, cov_matrix


# 3. Fit LDA Model Parameters Analytical Solution
class_0_df = data_trn.filter(F.col("indexedLabel") == 0.0)
class_1_df = data_trn.filter(F.col("indexedLabel") == 1.0)

n0 = class_0_df.count()
n1 = class_1_df.count()
total_n = n0 + n1

# Balanced Priors (pi0=0.5, pi1=0.5) to handle Class Imbalance natively
pi0, pi1 = 0.5, 0.5

# Extract means and covariance matrices
mu0, cov0 = get_class_stats(class_0_df, feature_names)
mu1, cov1 = get_class_stats(class_1_df, feature_names)

# Pooled Covariance Matrix
cov_pooled = ((n0 - 1) * cov0 + (n1 - 1) * cov1) / (total_n - 2)

# Solve LDA Weights: w = Cov_pooled^(-1) * (mu1 - mu0)
inv_cov_pooled = np.linalg.pinv(cov_pooled)
weights = inv_cov_pooled @ (mu1 - mu0)

# Intercept b = ln(pi1 / pi0) - 0.5 * (mu1 + mu0)^T @ w
intercept = np.log(pi1 / pi0) - 0.5 * ((mu1 + mu0) @ weights)


# 4. Score Validation Data via PySpark Column Expressions
score_expr = F.lit(float(intercept))
for name, w_val in zip(feature_names, weights):
    score_expr = score_expr + (F.col(name) * F.lit(float(w_val)))

data_val_scored = data_val.withColumn("z_score", score_expr).withColumn(
    "prob_positive", 1.0 / (1.0 + F.exp(-F.col("z_score")))
)

# 5. Model Evaluation
