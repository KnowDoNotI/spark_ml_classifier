# 7. Single-Pass Optimal Threshold Search
thresholds = [i / 20.0 for i in range(1, 20)]
exprs = []

for t in thresholds:
    tag = str(t).replace(".", "_")
    exprs.extend(
        [
            F.sum(
                F.when(
                    (F.col("prob_positive") >= t)
                    & (F.col("indexedLabel") == 1.0),
                    1,
                ).otherwise(0)
            ).alias(f"tp_{tag}"),
            F.sum(
                F.when(
                    (F.col("prob_positive") >= t)
                    & (F.col("indexedLabel") == 0.0),
                    1,
                ).otherwise(0)
            ).alias(f"fp_{tag}"),
            F.sum(
                F.when(
                    (F.col("prob_positive") < t)
                    & (F.col("indexedLabel") == 1.0),
                    1,
                ).otherwise(0)
            ).alias(f"fn_{tag}"),
        ]
    )

metrics_row = data_val_scored.agg(*exprs).collect()[0]

best_f1 = -1.0
best_threshold = 0.5

for t in thresholds:
    tag = str(t).replace(".", "_")
    tp = metrics_row[f"tp_{tag}"] or 0
    fp = metrics_row[f"fp_{tag}"] or 0
    fn = metrics_row[f"fn_{tag}"] or 0

    precision = tp / (tp + fp) if (tp + fp) > 0 else 0
    recall = tp / (tp + fn) if (tp + fn) > 0 else 0
    f1 = (
        (2 * precision * recall) / (precision + recall)
        if (precision + recall) > 0
        else 0
    )

    if f1 > best_f1:
        best_f1 = f1
        best_threshold = t

print(
    f"\nOptimal Threshold Found: {best_threshold:.2f} (Best Validation F1: {best_f1:.4f})"
)
